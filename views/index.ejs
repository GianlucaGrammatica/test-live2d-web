<!DOCTYPE html>
<html lang="it" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🌱 NaHida Plant — Test</title>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@4/dist/full.min.css" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    #live2d-canvas { width: 100%; height: 100%; touch-action: none; display: block; }
    .live2d-container { min-height: 400px; height: 70vh; }
  </style>
</head>
<body class="min-h-screen bg-base-200">
<div class="container mx-auto p-4">
  <h1 class="text-2xl font-bold text-center mb-4">🌱 Plant Viewer — Test</h1>

  <div class="flex flex-col lg:flex-row gap-4">

    <!-- MODELLO -->
    <div class="card bg-base-100 shadow-xl flex-1 live2d-container">
      <div class="card-body p-2 h-full">
        <canvas id="live2d-canvas"></canvas>
      </div>
    </div>

    <!-- PANNELLO TEST -->
    <div class="flex flex-col gap-4 w-full lg:w-72">

      <div class="card bg-base-100 shadow">
        <div class="card-body p-4">
          <h2 class="card-title text-sm">📡 Stato</h2>
          <div id="plant-status" class="text-sm opacity-70">Caricamento...</div>
        </div>
      </div>

      <!-- Personalizzazione -->
      <div class="card bg-base-100 shadow">
        <div class="card-body p-4 gap-3">
          <h2 class="card-title text-sm">🎨 Personalizzazione</h2>
          <div>
            <label class="label text-xs pb-0">Pot Color (0-2)</label>
            <input id="sl-pot" type="range" min="0" max="2" step="1" value="0"
                   class="range range-xs range-primary" oninput="updateAppearance()">
          </div>
          <div>
            <label class="label text-xs pb-0">Plant Variant (0-6)</label>
            <input id="sl-plant" type="range" min="0" max="6" step="1" value="0"
                   class="range range-xs range-secondary" oninput="updateAppearance()">
          </div>
          <div>
            <label class="label text-xs pb-0">Plant Color (0-5)</label>
            <input id="sl-plantColor" type="range" min="0" max="5" step="1" value="0"
                   class="range range-xs range-info" oninput="updateAppearance()">
          </div>
          <div>
            <label class="label text-xs pb-0">Flower Color (0-6)</label>
            <input id="sl-flower" type="range" min="0" max="6" step="1" value="0"
                   class="range range-xs range-accent" oninput="updateAppearance()">
          </div>
        </div>
      </div>

      <!-- Salute -->
      <div class="card bg-base-100 shadow">
        <div class="card-body p-4 gap-2">
          <h2 class="card-title text-sm">💧 Salute (test)</h2>
          <div class="flex gap-2">
            <button class="btn btn-success btn-sm flex-1" onclick="
                PlantViewer.setHealth({
                  soil_humidity: 70, temperature: 22,
                  last_watered: new Date().toISOString(),
                  water_interval_hours: 24
                })">😊 Sana</button>
            <button class="btn btn-warning btn-sm flex-1" onclick="
                PlantViewer.setHealth({
                  soil_humidity: 20, temperature: 38,
                  last_watered: new Date(Date.now() - 40*3600000).toISOString(),
                  water_interval_hours: 24
                })">😢 Triste</button>
          </div>
        </div>
      </div>

      <!-- Sonno -->
      <div class="card bg-base-100 shadow">
        <div class="card-body p-4 gap-2">
          <h2 class="card-title text-sm">☀️ Luminosità</h2>
          <div class="flex gap-2">
            <button class="btn btn-warning btn-sm flex-1"
                    onclick="PlantViewer.setSleeping(false)">☀️ Sveglia</button>
            <button class="btn btn-neutral btn-sm flex-1"
                    onclick="PlantViewer.setSleeping(true)">🌙 Dorme</button>
          </div>
        </div>
      </div>

      <button class="btn btn-primary" onclick="PlantViewer.tap()">👆 Tap manuale</button>

    </div>

    <!-- DEBUG PARAMETRI -->
    <div class="card bg-base-100 shadow-xl w-full lg:w-64 max-h-[70vh] overflow-y-auto">
      <div class="card-body p-3">
        <h2 class="card-title text-sm">🔧 Parametri live</h2>
        <table class="w-full">
          <tbody id="debug-params" class="text-xs"></tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/pixi.js@6.5.2/dist/browser/pixi.min.js"></script>
<script src="https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/pixi-live2d-display@0.4.0/dist/cubism4.min.js"></script>
<script src="/js/live2d-viewer.js"></script>

<script>
  function updateAppearance() {
    PlantViewer.setAppearance({
      pot_color:     parseInt(document.getElementById('sl-pot').value),
      plant_variant: parseInt(document.getElementById('sl-plant').value),
      plant_color: parseInt(document.getElementById('sl-plantColor').value),
      flower_color:  parseInt(document.getElementById('sl-flower').value),
    });
  }
</script>
</body>
</html>
